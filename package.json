{
  "name": "@sanchuang-dev/agent-publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test:unit": "vitest run",
    "test:browser": "tsx --test web/test/browser-smoke.test.ts",
    "test:browser-provider": "vitest run test/browser-provider.test.ts",
    "smoke:browser-provider": "tsx scripts/browser-provider-smoke.ts",
    "test": "npm run test:unit && npm run test:browser",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev:web": "vite web",
    "build": "vite build web",
    "smoke:session-constraint": "tsx scripts/session-constraint-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "playwright": "1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "27.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
