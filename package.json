{
  "name": "@sanchuang-dev/agent-publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "tsx --test test/**/*.test.ts web/test/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:web": "vite web",
    "build": "vite build web"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "playwright": "1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.5"
  }
}
