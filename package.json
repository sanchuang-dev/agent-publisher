{
  "name": "@sanchuang-dev/agent-publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "vite build web",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev:web": "vite web",
    "smoke:browser-provider": "tsx scripts/browser-provider-smoke.ts",
    "smoke:content-secretary-live": "tsx scripts/content-secretary-live-smoke.ts",
    "smoke:publishing-browser-mcp": "tsx scripts/publishing-browser-mcp-smoke.ts",
    "smoke:session-constraint": "tsx scripts/session-constraint-smoke.ts",
    "smoke:xhs-login": "tsx scripts/xiaohongshu-login-smoke.ts",
    "smoke:xhs-prepare": "tsx scripts/xiaohongshu-prepare-smoke.ts",
    "start:api": "tsx scripts/start-app.ts",
    "test": "npm run test:unit && npm run test:browser",
    "test:browser": "tsx --test web/test/browser-smoke.test.ts",
    "test:browser-provider": "vitest run test/browser-provider.test.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@playwright/mcp": "0.0.82",
    "@takumi-rs/core": "2.14.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "pi-mcp-adapter": "2.34.0",
    "playwright": "1.63.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "27.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.5",
    "vitest": "3.2.6",
    "@types/cross-spawn": "6.0.6"
  }
}
